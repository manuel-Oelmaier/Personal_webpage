---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Redirecting to Evals | Manuel Oelmaier"
	description="The LLM leaderboard lives at /evals/."
>
	<section class="fade-in eval-page">
		<header class="page-header">
			<h1>Moved</h1>
			<p class="section-subtitle">
				The leaderboard is now on the <a id="evals-redirect" href="/evals/">Evals</a> page.
			</p>
		</header>
	</section>
</BaseLayout>

<script is:inline>
	const search = window.location.search;
	const target = `/evals/${search}`;
	const link = document.getElementById('evals-redirect');
	if (link instanceof HTMLAnchorElement) {
		link.href = target;
	}
	location.replace(target);
</script>
