---
/**
 * Legacy /evals/{slug}/take/ → hub. Preserves ?seed= so shared runs still work.
 */
type StaticPath = {
	params: { slug: string };
};

export function getStaticPaths(): StaticPath[] {
	return [
		{ params: { slug: 'gpqa-diamond' } },
		{ params: { slug: 'mmmu-pro' } },
		{ params: { slug: 'mmlu-pro' } },
	];
}

const TAKE_DEST: Record<string, string> = {
	'gpqa-diamond': '/evals/gpqa-diamond/',
	'mmmu-pro': '/evals/mmmu-pro/',
	'mmlu-pro': '/evals/mmmu-pro/',
};

const slug = Astro.params.slug ?? '';
const dest = TAKE_DEST[slug] ?? '/blog/feeling-llm-benchmarks/';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="refresh" content={`0;url=${dest}`} />
		<link rel="canonical" href={dest} />
		<title>Moved</title>
	</head>
	<body>
		<p><a id="eval-redirect" href={dest}>Continue to the benchmark</a></p>
		<script is:inline>
			const link = document.getElementById('eval-redirect');
			const dest = link instanceof HTMLAnchorElement ? (link.getAttribute('href') ?? '/evals/') : '/evals/';
			location.replace(dest + window.location.search + window.location.hash);
		</script>
	</body>
</html>
