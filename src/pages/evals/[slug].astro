---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import McqEvalMount from '../../components/evals/McqEvalMount.astro';
import SciCodeMount from '../../components/evals/SciCodeMount.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

type BenchEntry = CollectionEntry<'benchmarks'>;

interface Props {
	entry: BenchEntry;
}

type StaticPath = {
	params: { slug: string };
	props: Props;
};

function formatPubDate(date: Date): string {
	return date.toLocaleDateString('en-US', {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
	});
}

export async function getStaticPaths(): Promise<StaticPath[]> {
	const entries = await getCollection('benchmarks');
	return entries.map((entry) => ({
		params: { slug: entry.id.replace(/\.md$/, '') },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
	title,
	description,
	purpose,
	citation,
	datasetSource,
	datasetSize,
	questionCount,
	poolSize,
	published,
	takeable,
} = entry.data;
const slug = entry.id.replace(/\.md$/, '');
const formattedDate = formatPubDate(published);
const boardHref = '/blog/feeling-llm-benchmarks/#evals-board';
const sizeLabel = slug === 'scicode' ? 'Subproblems' : 'Questions';
const drawPool = poolSize ?? datasetSize;
---

<BaseLayout
	title={`${title} · Evals | Manuel Oelmaier`}
	description={description}
	ogTitle={`${title} · Evals`}
>
	<section class="fade-in eval-page">
		<header class="page-header">
			<p class="eval-kicker">Benchmark</p>
			<h1>{title}</h1>
			<p class="section-subtitle">{description}</p>
		</header>

		<div class="eval-body">
			<aside class="post-problem" aria-labelledby="eval-purpose-heading">
				<span class="post-problem-label" id="eval-purpose-heading">Purpose</span>
				<p>{purpose}</p>
			</aside>

			<dl class="eval-bench-meta">
				<div>
					<dt>Published</dt>
					<dd>
						<time datetime={published.toISOString()}>{formattedDate}</time>
					</dd>
				</div>
				<div>
					<dt>Paper</dt>
					<dd>
						<a href={citation.url} target="_blank" rel="noopener noreferrer">{citation.label}</a>
					</dd>
				</div>
				<div>
					<dt>{sizeLabel}</dt>
					<dd>
						<a href={datasetSource} target="_blank" rel="noopener noreferrer">
							{datasetSize.toLocaleString('en-US')}
						</a>
					</dd>
				</div>
			</dl>

			{
				(entry.body ?? '').trim() ? (
					<div class="post-content eval-bench-body">
						<Content />
					</div>
				) : null
			}

			{
				takeable && (
					<p class="eval-lede">
						Each run draws {questionCount} of the {drawPool.toLocaleString('en-US')} questions
						(same seed → same items).
					</p>
				)
			}
			{
				slug === 'scicode' && (
					<p class="eval-lede">
						Each run walks 1 of 80 problems, subproblem by subproblem (same seed → same problem).
					</p>
				)
			}

			{takeable && <McqEvalMount slug={slug} autoStart={true} />}
			{slug === 'scicode' && <SciCodeMount />}

			<p class="eval-compare-row">
				<a id="eval-compare-board" class="button-link button-outline" href={boardHref}>
					Compare yourself to selected LLMs
				</a>
			</p>
		</div>
	</section>
</BaseLayout>
